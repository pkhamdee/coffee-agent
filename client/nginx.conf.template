server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same contract as the Vite dev proxy: /api/foo → ${BACKEND_URL}/foo
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # LLM calls can be slow (retries on rate limits).
        proxy_read_timeout 180s;
    }

    # SPA routes (/barista, /setup) fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
